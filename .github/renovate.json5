{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended", ":disableDependencyDashboard"],
  "enabledManagers": ["cargo", "github-actions"],
  "automerge": false,
  "dependencyDashboard": false,
  "minimumReleaseAge": "7 days",
  "prConcurrentLimit": 2,
  "prHourlyLimit": 1,
  "rangeStrategy": "bump",
  "separateMajorMinor": true,
  "schedule": ["before 5am on monday"],
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": ["before 5am on the first day of the month"]
  },
  "packageRules": [
    {
      "description": "Group core runtime dependencies",
      "matchManagers": ["cargo"],
      "matchPackageNames": ["anyhow", "chrono", "clap", "libc", "serde", "serde_json", "serde_yaml", "toml", "walkdir"],
      "groupName": "runtime dependencies"
    },
    {
      "description": "Keep pinned GitHub Actions updates separate from Rust crates",
      "matchManagers": ["github-actions"],
      "groupName": "github actions",
      "pinDigests": true
    },
    {
      "description": "Never automerge security or vulnerability remediation",
      "matchCategories": ["security"],
      "automerge": false,
      "minimumReleaseAge": null
    }
  ]
}
